# Ardenne Padel V2 — variables d'environnement
# Ne jamais committer de vraies valeurs. Voir CDC section 59.3 et 63.

# --- Application ---
NODE_ENV=development
API_PORT=3000
WEB_PORT=3001
PUBLIC_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:3000/api/v1
TIMEZONE_DISPLAY=Europe/Brussels

# --- Base de données ---
DATABASE_URL=postgres://ardenne:ardenne@localhost:5432/ardenne_padel_v2
DATABASE_POOL_MAX=10

# --- Auth locale ---
SESSION_SECRET=change-me
SESSION_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=48
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_FAILED_ATTEMPTS_WINDOW_MINUTES=15

# --- Feature flags Legacy / Dual Run (CDC section 48, 90) ---
LEGACY_MODE=dual_run                # dual_run | read_only | disabled
LEGACY_SYNC_ENABLED=true
LEGACY_WRITE_ENABLED=false          # ne jamais mettre true en local sans créneaux de test sécurisés
LEGACY_ACCESS_IMPORT_ENABLED=false
LEGACY_SYNC_INTERVAL_SECONDS=60
LEGACY_RECONCILIATION_INTERVAL_SECONDS=300

# --- Doinsport (Legacy) ---
DOINSPORT_BASE_URL=
DOINSPORT_CLUB_LOGIN=
DOINSPORT_CLUB_PASSWORD=
DOINSPORT_CLUB_ID=                  # dérivé/validé au démarrage, jamais hardcodé aveuglément (CDC 13.1)
DOINSPORT_USERCLUB_ID=               # valeur de repli seulement ; le JWT fait foi (CDC 13.1, V-008)
LEGACY_PRICE_MISMATCH_TOLERANCE_CENTS=50

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TERMINAL_LOCATION_ID=
TERMINAL_ENABLED=true
QR_HANDOFF_ENABLED=true
TAP_TO_PAY_ENABLED=false            # nécessite un client natif/kiosk compatible (CDC 22.5)
OFF_SESSION_GUARANTEE_ENABLED=true
WALLET_GUARANTEE_ENABLED=true

# --- Paiement partagé ---
PAYMENT_SPLIT_ENABLED=true
SPLIT_SERVICE_FEE_ENABLED=true
SPLIT_SERVICE_FEE_CENTS=100
SPLIT_SERVICE_FEE_ALLOCATION=ORGANIZER   # ORGANIZER | PRO_RATA

# --- Wallet ---
WALLET_ENABLED=true
WALLET_TOPUP_ENABLED=true

# --- Notifications ---
NOTIFICATION_PROVIDER=              # ex: sendgrid, postmark, ses
NOTIFICATION_FROM_EMAIL=
BOOKING_REMINDER_LEAD_MINUTES=45

# --- Accès / kiosque ---
ACCESS_PROVIDER=                    # implémentation de AccessProvider
V2_ACCESS_ENABLED=false
ACCESS_ENABLED_BEFORE_MINUTES=15
ACCESS_ENABLED_AFTER_MINUTES=15
KIOSK_DEVICE_SECRET=
KIOSK_SESSION_TTL_MINUTES=10
KIOSK_OFFLINE_THRESHOLD_MINUTES=5

# --- Back-office (Lot 9) ---
WALLET_HOLD_STALE_HOURS=24          # seuil "hold bloqué" des indicateurs de santé (CDC 39.3)

# --- Durcissement pré-pilote (Lot 10, CDC 59.2) ---
CORS_ALLOWED_ORIGINS=               # liste séparée par des virgules ; vide = PUBLIC_BASE_URL seul
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_AUTH_MAX_REQUESTS=20
PILOT_MODE_ENABLED=false            # cohorte pilote restreinte (Annexe B)

# --- Divers ---
MIGRATION_INVITATIONS_ENABLED=true
ADMIN_MOVE_ENABLED=true
NATIVE_API_FUTURE=false
