// =====================================================================
// Lot Nextore B/C/D — Catalogue bar + moteur transactionnel (comptes,
// participants, lignes de vente). Pas de paiement/caisse physique ici
// (Lots E/F/G) — voir plan d'exécution Nextore V2.
// =====================================================================

/// CDC Nextore §8 (CAT-002) — catégories/sous-catégories via `parentId`
/// auto-référencé (pas de second modèle "sous-catégorie" redondant).
model NextorePOSCategory {
  id           String               @id @default(uuid())
  label        String
  parentId     String?              @map("parent_id")
  parent       NextorePOSCategory?  @relation("CategoryParent", fields: [parentId], references: [id])
  children     NextorePOSCategory[] @relation("CategoryParent")
  displayOrder Int                  @default(0) @map("display_order")
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  articles NextoreArticle[]

  @@map("nextore_pos_categories")
}

/// CDC Nextore §8 — article vendable. `vatRatePercent` en champ libre (pas
/// de référentiel TVA partagé dans ardenne-padel-v2 à ce jour — confirmé en
/// lisant `docs/tva.md` : la plateforme ne gère qu'un taux unique 6% pour
/// les réservations, le bar a ses propres taux 6/12/21% sans référentiel
/// commun existant). `internalProductId` référence `pnl.nextore_products`
/// par simple chaîne (bases distinctes, pas de FK cross-DB) — Lot H la
/// consommera via l'API PNL à créer.
model NextoreArticle {
  id                 String             @id @default(uuid())
  code               String             @unique
  label              String
  shortLabel         String?            @map("short_label")
  categoryId         String             @map("category_id")
  category           NextorePOSCategory @relation(fields: [categoryId], references: [id])
  priceCents         Int                @map("price_cents")
  vatRatePercent     Decimal            @map("vat_rate_percent") @db.Decimal(5, 2)
  photoUrl           String?            @map("photo_url")
  active             Boolean            @default(true)
  displayOrder       Int                @default(0) @map("display_order")
  internalProductRef String?            @map("internal_product_ref")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  saleLines NextoreSaleLine[]

  @@index([categoryId])
  @@map("nextore_articles")
}

enum NextoreAccountStatus {
  OPEN
  PARTIALLY_PAID
  CLOSED
  VOID
  ANOMALY
}

/// CDC Nextore §7.3/§10 — compte/addition ouverte. `customerId` référence
/// `User.id` (jamais de second référentiel client, CDC Nextore §0.1) ;
/// `version` porte le verrouillage optimiste (CDC Nextore §30.3 — deux
/// opérateurs sur le même compte, jamais d'écrasement silencieux).
model NextoreAccount {
  id             String               @id @default(uuid())
  status         NextoreAccountStatus @default(OPEN)
  label          String?
  customerId     String?              @map("customer_id")
  customer       User?                @relation(fields: [customerId], references: [id])
  openedByUserId String               @map("opened_by_user_id")
  openedAt       DateTime             @default(now()) @map("opened_at")
  closedAt       DateTime?            @map("closed_at")
  version        Int                  @default(0)

  participants NextoreParticipant[]
  saleLines    NextoreSaleLine[]
  payments     NextorePayment[]

  @@index([status])
  @@index([customerId])
  @@map("nextore_accounts")
}

/// CDC Nextore §7.5/§11 — participant d'un compte, identifié (`customerId`)
/// ou local (`displayName`). `leftAt` fige la situation au départ (GRP-003) :
/// une ligne créée après `leftAt` ne peut plus lui être affectée (contrôle
/// service, pas contrainte DB — la validité dépend de l'horodatage de la
/// ligne, pas seulement de l'état courant).
model NextoreParticipant {
  id          String         @id @default(uuid())
  accountId   String         @map("account_id")
  account     NextoreAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customerId  String?        @map("customer_id")
  customer    User?          @relation(fields: [customerId], references: [id])
  displayName String?        @map("display_name")
  joinedAt    DateTime       @default(now()) @map("joined_at")
  leftAt      DateTime?      @map("left_at")

  saleLines NextoreSaleLine[]

  @@index([accountId])
  @@map("nextore_participants")
}

enum NextoreSaleLineStatus {
  ACTIVE
  VOIDED
}

/// CDC Nextore §7.4 (COR-001) — jamais de suppression physique : une ligne
/// annulée passe `VOIDED` avec motif, elle reste visible dans le compte et
/// le registre. `unitPriceCentsAtSale`/`vatRateAtSaleP ercent` sont un
/// snapshot immuable (CAT-004) — ne jamais relire `NextoreArticle` pour
/// recalculer une vente passée.
model NextoreSaleLine {
  id                   String                @id @default(uuid())
  accountId            String                @map("account_id")
  account              NextoreAccount        @relation(fields: [accountId], references: [id])
  articleId            String                @map("article_id")
  article              NextoreArticle        @relation(fields: [articleId], references: [id])
  participantId        String?               @map("participant_id")
  participant          NextoreParticipant?   @relation(fields: [participantId], references: [id])
  quantity             Decimal               @db.Decimal(10, 3)
  unitPriceCentsAtSale Int                   @map("unit_price_cents_at_sale")
  vatRateAtSalePercent Decimal               @map("vat_rate_at_sale_percent") @db.Decimal(5, 2)
  operatorUserId       String                @map("operator_user_id")
  status               NextoreSaleLineStatus @default(ACTIVE)
  voidReason           String?               @map("void_reason")
  voidedByUserId       String?               @map("voided_by_user_id")
  voidedAt             DateTime?             @map("voided_at")
  createdAt            DateTime              @default(now()) @map("created_at")

  @@index([accountId])
  @@index([participantId])
  @@map("nextore_sale_lines")
}

// =====================================================================
// Lot Nextore E — Paiements (cash/carte/crédits), idempotence
// =====================================================================

enum NextorePaymentMethod {
  CASH
  CARD
  WALLET_CREDIT
}

/// CDC Nextore §12 (PAY-*). `PENDING` n'existe que pour `WALLET_CREDIT`, le
/// temps du débit wallet (gate d'idempotence par insertion avant le débit,
/// cf. NextorePaymentsService) — CASH/CARD passent directement à `RECORDED`
/// en une seule écriture, déjà atomique. `FAILED` = débit wallet refusé
/// après réservation de la ligne (rare : la disponibilité est déjà vérifiée
/// avant insertion) ; ce statut n'est volontairement pas rejouable avec la
/// même `idempotencyKey` dans ce lot (limitation documentée).
enum NextorePaymentStatus {
  PENDING
  RECORDED
  FAILED
  REVERSED
}

/// CDC Nextore §12/§30.1 — `idempotencyKey` (unique) empêche qu'un double
/// clic ou un retry réseau ne crée deux paiements (PAY-012, CDC §60 "Paiement
/// déjà enregistré"). Jamais de suppression : une annulation passe par
/// `reversalOfPaymentId`, motif obligatoire (COR-002/COR-004).
model NextorePayment {
  id                  String               @id @default(uuid())
  accountId           String               @map("account_id")
  account             NextoreAccount       @relation(fields: [accountId], references: [id])
  participantId       String?              @map("participant_id")
  amountCents         Int                  @map("amount_cents")
  method              NextorePaymentMethod
  status              NextorePaymentStatus @default(RECORDED)
  externalReference   String?              @map("external_reference")
  walletTransactionId String?              @map("wallet_transaction_id")
  /// Lot Nextore G — session de caisse ouverte au moment du paiement
  /// (résolue automatiquement, jamais choisie par l'opérateur). Nullable :
  /// un paiement enregistré hors session (ne devrait pas arriver en usage
  /// normal une fois G en place) reste possible plutôt que de bloquer une
  /// vente, mais n'apparaît alors dans aucun rapport de caisse (CASH-010).
  cashSessionId       String?              @map("cash_session_id")
  idempotencyKey      String               @unique @map("idempotency_key")
  recordedByUserId    String               @map("recorded_by_user_id")
  reversalOfPaymentId String?              @map("reversal_of_payment_id")
  reversedByUserId    String?              @map("reversed_by_user_id")
  reversedAt          DateTime?            @map("reversed_at")
  reason              String?
  createdAt           DateTime             @default(now()) @map("created_at")

  @@index([accountId])
  @@index([status])
  @@index([cashSessionId])
  @@map("nextore_payments")
}

// =====================================================================
// Lot Nextore G — Sessions de caisse (CASH-*)
// =====================================================================

enum NextoreCashSessionStatus {
  OPEN
  CLOSED
}

/// CDC Nextore §15 — une session à la fois (une seule caisse physique dans
/// ce club, cf. audit Phase 0 : un seul terminal Loyaltek). `declaredOpeningCents`
/// est un comptage aveugle (CASH-003 : le théorique précédent n'est
/// volontairement pas pré-rempli côté service, à l'interface de le proposer
/// ou non). Le théorique de clôture se calcule à la demande (mouvements +
/// paiements cash de la session), jamais stocké tant que la session est
/// ouverte — seul `closingTheoreticalCents` fige le calcul au moment de la
/// clôture (CASH-007).
model NextoreCashSession {
  id                      String                   @id @default(uuid())
  status                  NextoreCashSessionStatus @default(OPEN)
  openedByUserId          String                   @map("opened_by_user_id")
  openedAt                DateTime                 @default(now()) @map("opened_at")
  declaredOpeningCents    Int                      @map("declared_opening_cents")
  closedByUserId          String?                  @map("closed_by_user_id")
  closedAt                DateTime?                @map("closed_at")
  declaredClosingCents    Int?                     @map("declared_closing_cents")
  theoreticalClosingCents Int?                     @map("theoretical_closing_cents")
  varianceCents           Int?                     @map("variance_cents")
  varianceJustification   String?                  @map("variance_justification")

  movements NextoreCashMovement[]

  @@index([status])
  @@map("nextore_cash_sessions")
}

enum NextoreCashMovementType {
  IN
  OUT
}

/// CDC Nextore §15 (CASH-005) — mouvement hors vente (apport, retrait,
/// dépôt banque...). Jamais de suppression, motif obligatoire (AUD-005).
model NextoreCashMovement {
  id              String                  @id @default(uuid())
  sessionId       String                  @map("session_id")
  session         NextoreCashSession      @relation(fields: [sessionId], references: [id])
  type            NextoreCashMovementType
  amountCents     Int                     @map("amount_cents")
  reason          String
  createdByUserId String                  @map("created_by_user_id")
  createdAt       DateTime                @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("nextore_cash_movements")
}

// ---------------------------------------------------------------------------
// Academy — Phase A (MVP disponibilités). Réutilise `users`/`Role.COACH` pour
// le prof, `notifications`/`audit` existants. Périmètre et décisions : voir
// docs Academy (ACADEMY_MVP_SPEC.md, ACADEMY_ARCHITECTURE.md, GAP analysis).
// ---------------------------------------------------------------------------

enum AcademyActorType {
  TEACHER
  STUDENT
}

enum AcademyCourseType {
  INDIVIDUAL
  GROUP
}

enum AcademyLessonStatus {
  DRAFT
  PROPOSED
  CONFIRMED
  CANCELLED
}

/// Identité élève Academy, indépendante d'un compte V2 complet (accès par
/// token temporaire — cf. AcademyInvitation). `userId` se remplit seulement
/// si/quand cet élève obtient un compte Ardenne Padel V2 à part entière.
model AcademyStudent {
  id        String   @id @default(uuid())
  userId    String?  @unique @map("user_id")
  firstName String   @map("first_name")
  lastName  String?  @map("last_name")
  email     String
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")

  user           User?                      @relation(fields: [userId], references: [id])
  invitations    AcademyInvitation[]
  availabilities AcademyAvailability[]
  courseRequests AcademyCourseRequest[]
  lessons        AcademyLessonParticipant[]

  @@index([email])
  @@map("academy_students")
}

/// Accès temporaire sécurisé (token opaque, seul le hash est stocké — même
/// pattern que `EmailVerificationToken`/`PasswordResetToken`). Renouvelable
/// (nouvelle ligne, ancienne révoquée) et révocable indépendamment.
model AcademyInvitation {
  id        String    @id @default(uuid())
  studentId String    @map("student_id")
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  usedAt    DateTime? @map("used_at")

  student AcademyStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("academy_invitations")
}

/// Bloc de disponibilité — prof (`teacherId` = `User.id`, role COACH) ou
/// élève (`studentId`). Exactement un des deux est renseigné, cohérent avec
/// `actorType` (contrôlé en application, Prisma ne portant pas de CHECK).
model AcademyAvailability {
  id         String           @id @default(uuid())
  actorType  AcademyActorType @map("actor_type")
  teacherId  String?          @map("teacher_id")
  studentId  String?          @map("student_id")
  startAt    DateTime         @map("start_at")
  endAt      DateTime         @map("end_at")
  /// Règle de récurrence optionnelle (ex. `{ freq: "WEEKLY", byDay: "MO" }`) ;
  /// une ligne EXCEPTION référence la série récurrente pour la modifier/annuler
  /// ponctuellement — format à stabiliser à l'usage, non normatif en Phase A.
  recurrence Json?
  status     String           @default("ACTIVE")
  source     String           @default("MANUAL")
  createdAt  DateTime         @default(now()) @map("created_at")

  teacher User?           @relation("AcademyTeacherAvailabilities", fields: [teacherId], references: [id])
  student AcademyStudent? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([studentId])
  @@map("academy_availabilities")
}

model AcademyCourseRequest {
  id             String            @id @default(uuid())
  studentId      String            @map("student_id")
  requestedHours Float             @map("requested_hours")
  courseType     AcademyCourseType @map("course_type")
  status         String            @default("SUBMITTED")
  createdAt      DateTime          @default(now()) @map("created_at")

  student AcademyStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("academy_course_requests")
}

/// Proposition/confirmation de cours (§13 besoin urgent). `bookingId` n'est
/// PAS une clé étrangère Prisma vers `Booking` en Phase A : tant que le
/// branchement au module `bookings` n'est pas fait (Phase B), une ligne
/// CONFIRMED n'est jamais une réservation de terrain garantie — voir
/// ACADEMY_MVP_SPEC.md §6.
model AcademyLesson {
  id        String              @id @default(uuid())
  teacherId String              @map("teacher_id")
  startAt   DateTime            @map("start_at")
  endAt     DateTime            @map("end_at")
  bookingId String?             @map("booking_id")
  status    AcademyLessonStatus @default(DRAFT)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  teacher      User                       @relation("AcademyTeacherLessons", fields: [teacherId], references: [id])
  participants AcademyLessonParticipant[]

  @@index([teacherId])
  @@map("academy_lessons")
}

model AcademyLessonParticipant {
  lessonId  String @map("lesson_id")
  studentId String @map("student_id")

  lesson  AcademyLesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student AcademyStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([lessonId, studentId])
  @@map("academy_lesson_participants")
}

// =====================================================================
// Lot Nextore I — Rapprochement Europabank (REC0-*)
// =====================================================================

/// CDC Nextore §23 — un import = un export du terminal Loyaltek/Europabank
/// (CSV/Excel). `sourceFilename` sert de repère humain, pas de clé
/// d'idempotence (un même fichier peut légitimement être réimporté après
/// correction manuelle — la déduplication se fait au niveau des entrées via
/// le rapprochement lui-même, pas au niveau du batch).
model NextoreReconciliationImport {
  id               String   @id @default(uuid())
  importedByUserId String   @map("imported_by_user_id")
  importedAt       DateTime @default(now()) @map("imported_at")
  sourceFilename   String?  @map("source_filename")
  totalRows        Int      @map("total_rows")

  entries NextoreReconciliationEntry[]

  @@map("nextore_reconciliation_imports")
}

enum NextoreReconciliationStatus {
  UNMATCHED
  MATCHED
  AMBIGUOUS
}

/// CDC Nextore §23 (REC0-002/003) — une ligne de relevé Europabank. Le
/// rapprochement se fait sur montant EXACT (REC0-007 : "aucune tolérance de
/// montant ne doit être appliquée silencieusement") + fenêtre temporelle
/// explicite (pas une tolérance de montant, un délai de règlement normal
/// entre vente et remontée bancaire). `matchedPaymentId` référence
/// `NextorePayment.id` en chaîne libre (même statut que `bookingId` sur
/// `WalletTransaction` : deux domaines distincts, pas de FK cross-souci).
model NextoreReconciliationEntry {
  id                  String                      @id @default(uuid())
  importId            String                      @map("import_id")
  import              NextoreReconciliationImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  externalDate        DateTime                    @map("external_date")
  externalAmountCents Int                         @map("external_amount_cents")
  externalReference   String?                     @map("external_reference")
  status              NextoreReconciliationStatus @default(UNMATCHED)
  matchedPaymentId    String?                     @map("matched_payment_id")
  matchedByUserId     String?                     @map("matched_by_user_id")
  matchedAt           DateTime?                   @map("matched_at")
  note                String?

  @@index([importId])
  @@index([status])
  @@index([matchedPaymentId])
  @@map("nextore_reconciliation_entries")
}
