// AFPadel (fédération, mon.afpadel.be) — import de l'effectif du club
// =====================================================================

/// Effectif du club lu sur mon.afpadel.be/club (liste paginée) puis complété
/// terrain par terrain via /player/{id} (demande explicite 2026-09-14).
/// `rawListData`/`rawPlayerData` conservent la réponse brute (props Inertia)
/// tant que la structure exacte de chaque page n'est pas figée par l'usage
/// réel — même précaution que `LegacyBooking.accessCodes` : on ne perd
/// jamais un champ qu'on n'a pas encore modélisé explicitement.
model AfpMember {
