  afpPlayerId    Int       @unique @map("afp_player_id")
  licenseNumber  String?   @map("license_number")
  fullName       String    @map("full_name")
  gender         String?
  category       String?
  points         Int?
  // Champs de contact/identité (demande explicite 2026-09-14) — extraits de
  // rawPlayerData au moment de la synchro de la fiche détaillée, jamais
  // renseignés avant (colonnes nulles tant que detailSyncedAt est nul).
  email          String?
