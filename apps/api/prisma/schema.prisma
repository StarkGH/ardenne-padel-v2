generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  COACH
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

/// CDC §45 — table users. legacy_client_id / stripe_customer_id restent des
/// références externes, jamais des clés primaires du domaine (CDC §2.5).
model User {
  id               String     @id @default(uuid())
  email            String     @unique
  passwordHash     String     @map("password_hash")
  firstName        String     @map("first_name")
  lastName         String     @map("last_name")
  phone            String?
  status           UserStatus @default(PENDING_VERIFICATION)
  role             Role       @default(CUSTOMER)
  stripeCustomerId String?    @map("stripe_customer_id")
  /// CDC §100, Annexe B — cohorte pilote restreinte (`PILOT_MODE_ENABLED`).
  pilotUser        Boolean    @default(false) @map("pilot_user")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  lastLoginAt      DateTime?  @map("last_login_at")

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  emailChangeTokens       EmailChangeToken[]
  bookingsOrganized       Booking[]
  payments                Payment[]
  walletAccount           WalletAccount?
  creditPackPurchases     CreditPackPurchase[]
  clientNotes             ClientNote[]
  legacyClientLink        LegacyClient?
  nextoreAccounts         NextoreAccount[]
  nextoreParticipations   NextoreParticipant[]
  academyAvailabilities   AcademyAvailability[]    @relation("AcademyTeacherAvailabilities")
  academyLessons          AcademyLesson[]          @relation("AcademyTeacherLessons")
  academyStudentLink      AcademyStudent?

  @@map("users")
}

/// Sessions serveur (pas de JWT stateless) pour permettre une révocation
/// immédiate et une "déconnexion de toutes les sessions" triviale (CDC §7.2).
model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  @@index([userId])
  @@map("email_verification_tokens")
}

/// CDC §7.2, §54 écran 18 — changement d'e-mail avec re-vérification.
/// Distinct d'`EmailVerificationToken` (activation de compte) : ici, le
/// compte est déjà `ACTIVE`, seul `newEmail` change une fois le lien cliqué.
model EmailChangeToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String    @map("new_email")
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  @@index([userId])
  @@map("email_change_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Rate limiting basique des tentatives de connexion (CDC §59.1).
model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ipAddress String?  @map("ip_address")
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("login_attempts")
}

// =====================================================================
// Lot 2 — Legacy Doinsport adapter
// =====================================================================
//
// Note de scope : le CDC §9 place `courts` dans le module Booking (Lot 3).
// Le Lot 2 (adapter Legacy) a besoin d'une cible locale minimale pour que
// `legacy_court_mapping` ait un sens et soit testable dès maintenant — la
// définition ci-dessous reprend exactement les champs du CDC §9 (rien de
// plus), donc aucune reprise n'est attendue au Lot 3 : il enrichira ce
// modèle (relations availability/pricing) sans le redéfinir.
//
// `legacy_clients` reprend CDC §45 et fait aussi office de la table
// `legacy_user_mapping` du CDC §14 (les deux définitions se recouvraient :
// `linked_user_id` ici joue le rôle de `user_id`/`shadow_client_id` là-bas)
// — simplification volontaire, une seule table plutôt que deux redondantes
// (CDC §0 : "implémenter une solution simple, testable et réversible").
//
// `legacy_booking_mappings.booking_id` reste une simple chaîne (pas de
// relation Prisma) tant que le module `bookings` (Lot 3) n'existe pas ;
// à transformer en relation stricte dès son introduction.

enum CourtType {
  SIMPLE
  DOUBLE
}

/// CDC §9 — terrains. Ne jamais baser la logique sur le nom (`slug`/`id`
/// uniquement). Étendu au Lot 3 avec availability/pricing.
model Court {
  id                 String    @id @default(uuid())
  name               String
  slug               String    @unique
  courtType          CourtType @map("court_type")
  capacity           Int
  active             Boolean   @default(true)
  displayOrder       Int       @map("display_order")
  legacyPlaygroundId String?   @unique @map("legacy_playground_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  legacyCourtMapping LegacyCourtMapping?
  openingRules       OpeningRule[]
  courtClosures      CourtClosure[]
  durationRules      DurationRule[]
  tariffRules        TariffRule[]
  bookings           Booking[]
  legacyBookings     LegacyBooking[]
  automationZones    Zone[]

  @@map("courts")
}

/// CDC §14 — table de mapping dédiée à l'adapter Legacy (le reste du code ne
/// doit jamais avoir besoin de connaître `legacyActivityId`).
model LegacyCourtMapping {
  id                 String   @id @default(uuid())
  courtId            String   @unique @map("court_id")
  court              Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  legacyPlaygroundId String   @unique @map("legacy_playground_id")
  legacyActivityId   String   @map("legacy_activity_id")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("legacy_court_mapping")
}

/// CDC §45 (`legacy_clients`) — cache local minimal des clients Doinsport
/// ("Shadow Client"), utilisé pour la recherche joueurs et la migration
/// (CDC §7.3) sans jamais appeler `getClients()` à la volée (CDC §19.3).
/// `migrationStatus` porte la machine à états CDC §7.4 explicitement plutôt
/// que de la déduire de `linkedUserId` (INVITED et MIGRATION_PENDING ont
/// tous deux `linkedUserId` nul, mais ne sont pas le même état — voir
/// ADR-0031).
model LegacyClient {
  id              String                @id @default(uuid())
  provider        String                @default("DOINSPORT")
  externalId      String                @unique @map("external_id")
  firstName       String                @map("first_name")
  lastName        String                @map("last_name")
  email           String?
  phone           String?
  linkedUserId    String?               @unique @map("linked_user_id")
  linkedUser      User?                 @relation(fields: [linkedUserId], references: [id])
  migrationStatus ClientMigrationStatus @default(LEGACY_ONLY) @map("migration_status")
  /// CDC §7.5 — renseigné uniquement en `MERGE_REQUIRED`, texte libre à
  /// l'usage de l'admin qui tranchera manuellement (ex. "GSM identique à
  /// user X mais e-mail différent").
  mergeNote       String?               @map("merge_note")
  lastSyncedAt    DateTime              @map("last_synced_at")
  rawHash         String?               @map("raw_hash")

  migrationInvitations ClientMigrationInvitation[]
  legacyBookings       LegacyBooking[]

  @@index([email])
  @@index([migrationStatus])
  @@map("legacy_clients")
}

/// CDC §7.4.
enum ClientMigrationStatus {
  LEGACY_ONLY
  INVITED
  MIGRATION_PENDING
  MIGRATED
  DISABLED
  MERGE_REQUIRED
}

/// CDC §7.3 points 3-6 — jeton de migration, même pattern opaque haché que
/// `EmailVerificationToken`/`PasswordResetToken`/`EmailChangeToken`, mais
/// rattaché à un `LegacyClient` plutôt qu'à un `User` : à l'émission, le
/// compte V2 n'existe pas encore — c'est précisément ce que ce jeton crée
/// à l'usage. La possession du lien vaut vérification d'e-mail (CDC §7.3.5).
model ClientMigrationInvitation {
  id             String       @id @default(uuid())
  legacyClientId String       @map("legacy_client_id")
  legacyClient   LegacyClient @relation(fields: [legacyClientId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique @map("token_hash")
  createdAt      DateTime     @default(now()) @map("created_at")
  expiresAt      DateTime     @map("expires_at")
  usedAt         DateTime?    @map("used_at")

  @@index([legacyClientId])
  @@map("client_migration_invitations")
}

/// Réservations connues côté Doinsport uniquement (pas de `Booking` V2
/// correspondant) — importées pour deux usages distincts (ADR-0031) :
/// (1) alimenter `AvailabilityRepository.findOccupyingBookings` en
/// "occupations externes" (CDC §10.3, jusqu'ici non implémenté malgré le
/// commentaire qui l'annonçait dès le Lot 8) ; (2) historique client
/// affiché côté fiche client admin. Une réservation Legacy peut couvrir
/// plusieurs terrains (`playgroundIds` de `LegacyBookingDto`) : aplatie en
/// une ligne par terrain occupé plutôt qu'un tableau, pour permettre une
/// requête directe par terrain+plage horaire (même besoin que `Booking`).
model LegacyBooking {
  id                 String                     @id @default(uuid())
  externalId         String                     @map("external_id")
  courtId            String                     @map("court_id")
  court              Court                      @relation(fields: [courtId], references: [id], onDelete: Cascade)
  /// Nullable : la correspondance DTO actuelle (`getBooking`) n'expose pas
  /// encore le propriétaire Doinsport de la réservation — dépendance
  /// explicite pour le lot d'import (voir ADR-0031), pas une omission
  /// silencieuse ici.
  legacyClientId     String?                    @map("legacy_client_id")
  legacyClient       LegacyClient?              @relation(fields: [legacyClientId], references: [externalId])
  startAt            DateTime                   @map("start_at")
  endAt              DateTime                   @map("end_at")
  canceled           Boolean                    @default(false)
  comment            String?
  lastSyncedAt       DateTime                   @map("last_synced_at")
  rawHash            String?                    @map("raw_hash")
  /// CDC §55 écran 3 — total dû par les participants non annulés
  /// (`participants[].price` Doinsport, somme) et total encaissé
  /// (`payments[]` statut `succeeded`, somme `amountReceived`). Conservés
  /// séparément (pas seulement `fullyPaid`) pour permettre le calcul du CA
  /// planning sur les réservations Doinsport (ADR-0038 addendum "CA lignes
  /// Doinsport") sans recalcul depuis le payload brut à chaque page.
  priceDueCents      Int                        @default(0) @map("price_due_cents")
  priceReceivedCents Int                        @default(0) @map("price_received_cents")
  /// Dérivé de `priceReceivedCents >= priceDueCents` à l'import. Pas de
  /// statut par participant : `payments[].participantId` ne correspond à
  /// aucun identifiant exposé par ailleurs dans `participants[]` (vérifié
  /// empiriquement sur plusieurs réservations réelles) — seule l'agrégation
  /// au niveau de la réservation est fiable. `true` par défaut (pas d'alerte
  /// tant que le calcul n'a pas explicitement établi un manque).
  fullyPaid          Boolean                    @default(true) @map("fully_paid")
  /// Codes d'accès Doinsport tels que renvoyés par `getBooking()`
  /// (`[{code, playgroundName, accessCodeEnabledBefore}]`), déjà en clair
  /// côté Doinsport (pas de chiffrement ici, contrairement à `AccessGrant` :
  /// cette réservation n'a jamais transité par V2). Rafraîchi à chaque sync
  /// (§55 écran 22 — "Accès", demande explicite : voir aussi tout Doinsport,
  /// pas seulement les réservations V2/Dual Run).
  accessCodes        Json?                      @map("access_codes")
  participants       LegacyBookingParticipant[]

  @@unique([externalId, courtId])
  @@index([courtId, startAt, endAt])
  @@index([legacyClientId])
  @@map("legacy_bookings")
}

/// CDC §55 écran 3 — participants d'une réservation Doinsport, dénormalisés
/// à l'import pour affichage direct sur le planning sans recalcul à chaque
/// page (voir ADR-0038 addendum "Planning enrichi"). Une ligne par
/// participant et par import (recréées à chaque resynchro de la réservation
/// parente, cascade sur `LegacyBooking`) plutôt qu'un upsert incrémental :
/// la liste des participants d'une réservation Doinsport n'a pas d'id
/// stable côté API, plus simple et fiable de tout regénérer.
model LegacyBookingParticipant {
  id                  String        @id @default(uuid())
  legacyBookingId     String        @map("legacy_booking_id")
  legacyBooking       LegacyBooking @relation(fields: [legacyBookingId], references: [id], onDelete: Cascade)
  /// externalId du LegacyClient si résolu (voir `bookingOwnerClientId`,
  /// même dépendance qu'ailleurs sur le mapping DTO) — nullable sinon.
  legacyClientId      String?       @map("legacy_client_id")
  firstName           String        @map("first_name")
  lastName            String        @map("last_name")
  canceled            Boolean       @default(false)
  /// Prix dû par ce participant (`participants[].price` Doinsport), fiable
  /// par participant contrairement au statut de paiement (voir `fullyPaid`
  /// sur `LegacyBooking`) — le prix est porté directement par l'objet
  /// participant, pas déduit d'un rapprochement avec `payments[]`.
  priceCents          Int           @default(0) @map("price_cents")
  /// Nombre de réservations non annulées de ce joueur, tel que connu par V2
  /// au moment du dernier import (uniquement ce que la synchro a couvert,
  /// pas l'historique complet Doinsport) — recalculé et réécrit sur
  /// l'ensemble des lignes de ce client à chaque import plutôt qu'à
  /// l'affichage (voir ADR-0038 addendum).
  activeBookingsCount Int           @default(0) @map("active_bookings_count")

  @@index([legacyBookingId])
  @@index([legacyClientId])
  @@map("legacy_booking_participants")
}

/// Traçabilité des exécutions du job de synchro périodique (CDC §16.2,
/// `LEGACY_SYNC_INTERVAL_SECONDS`, jamais consommé jusqu'ici) — table
/// dédiée plutôt que `AuditLogService` : ce n'est pas un acteur humain qui
/// agit, et le volume/la fréquence d'un job récurrent ne doit pas polluer
/// le journal d'audit destiné à la revue humaine (CDC §58).
model LegacySyncRun {
  id           String            @id @default(uuid())
  kind         LegacySyncKind
  status       LegacySyncStatus2 @default(RUNNING)
  startedAt    DateTime          @default(now()) @map("started_at")
  finishedAt   DateTime?         @map("finished_at")
  itemsSeen    Int               @default(0) @map("items_seen")
  itemsChanged Int               @default(0) @map("items_changed")
  errorSummary String?           @map("error_summary")

  @@index([kind, startedAt])
  @@map("legacy_sync_runs")
}

enum LegacySyncKind {
  CLIENTS
  BOOKINGS
}

/// Nommée `LegacySyncStatus2` pour ne pas entrer en collision avec
/// `LegacySyncStatus` (existant, porte le statut de sync d'une réservation
/// individuelle créée côté V2 — concept distinct de l'issue d'une
/// exécution de job).
enum LegacySyncStatus2 {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum LegacySyncStatus {
  PENDING
  CONFIRMED
  CONFIRMATION_UNKNOWN
  FAILED
  CANCEL_PENDING
  CANCELED
}

/// CDC §14/§45 — trace du lien entre une réservation V2 et sa contrepartie
/// Legacy, y compris le marqueur de corrélation APV2 (CDC §16.1). Relation
/// stricte vers `Booking` depuis le Lot 3 (le Lot 2 utilisait une simple
/// chaîne, `bookings` n'existait pas encore).
model LegacyBookingMapping {
  id                String           @id @default(uuid())
  bookingId         String           @unique @map("booking_id")
  booking           Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  legacyBookingId   String?          @map("legacy_booking_id")
  correlationMarker String           @unique @map("correlation_marker")
  syncStatus        LegacySyncStatus @default(PENDING) @map("sync_status")
  lastSyncAt        DateTime?        @map("last_sync_at")
  lastError         String?          @map("last_error")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([legacyBookingId])
  @@map("legacy_booking_mappings")
}

/// Stockage du JWT club Doinsport (courte durée de vie, ~1h — CDC §13.1).
/// Jamais loggé (CDC §57.1) ; conservé en base comme dans le code audité
/// (`padel-service/db.js`), simplement porté de SQLite vers PostgreSQL.
model LegacyAuthToken {
  id        String   @id @default(uuid())
  token     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("legacy_auth_tokens")
}

// =====================================================================
// Lot 3 — Booking core (availability, pricing, bookings, social basique)
// =====================================================================

/// CDC §10.1 — créneaux d'ouverture. `courtId` nul = s'applique à tous les
/// terrains. Ne jamais hardcoder les horaires dans le code (CDC §63).
model OpeningRule {
  id         String    @id @default(uuid())
  courtId    String?   @map("court_id")
  court      Court?    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  dayOfWeek  Int       @map("day_of_week") // 0 = dimanche ... 6 = samedi
  startTime  String    @map("start_time") // "HH:mm"
  endTime    String    @map("end_time")
  validFrom  DateTime  @map("valid_from")
  validUntil DateTime? @map("valid_until")
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([courtId])
  @@map("opening_rules")
}

enum CourtClosureType {
  MAINTENANCE
  EVENT
  ADMIN_BLOCK
}

/// CDC §10.1 — fermetures ponctuelles d'un terrain.
model CourtClosure {
  id          String           @id @default(uuid())
  courtId     String           @map("court_id")
  court       Court            @relation(fields: [courtId], references: [id], onDelete: Cascade)
  startAt     DateTime         @map("start_at")
  endAt       DateTime         @map("end_at")
  reason      String?
  closureType CourtClosureType @map("closure_type")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([courtId, startAt, endAt])
  @@map("court_closures")
}

/// CDC §10.1 — durées autorisées selon terrain/plage horaire. `courtId` nul
/// = s'applique à tous les terrains du `courtType` indiqué (lui aussi
/// nullable = tous terrains).
model DurationRule {
  id                      String     @id @default(uuid())
  courtId                 String?    @map("court_id")
  court                   Court?     @relation(fields: [courtId], references: [id], onDelete: Cascade)
  courtType               CourtType? @map("court_type")
  startTime               String     @map("start_time")
  endTime                 String     @map("end_time")
  allowedDurationsMinutes Int[]      @map("allowed_durations_minutes")
  validFrom               DateTime   @map("valid_from")
  validUntil              DateTime?  @map("valid_until")
  active                  Boolean    @default(true)
  createdAt               DateTime   @default(now()) @map("created_at")

  @@index([courtId])
  @@map("duration_rules")
}

/// CDC §11.1 — moteur tarifaire V2, priorité **explicite** (jamais déduite
/// de `createdAt`). Champs en centimes entiers (CDC §80).
model TariffRule {
  id                       String     @id @default(uuid())
  name                     String
  active                   Boolean    @default(true)
  courtId                  String?    @map("court_id")
  court                    Court?     @relation(fields: [courtId], references: [id], onDelete: Cascade)
  courtType                CourtType? @map("court_type")
  validFrom                DateTime   @map("valid_from")
  validUntil               DateTime?  @map("valid_until")
  daysOfWeek               Int[]      @map("days_of_week")
  startTime                String     @map("start_time")
  endTime                  String     @map("end_time")
  durationMinutes          Int        @map("duration_minutes")
  priceTotalCents          Int?       @map("price_total_cents")
  pricePerParticipantCents Int?       @map("price_per_participant_cents")
  referenceCapacity        Int        @map("reference_capacity")
  priority                 Int
  tags                     String[]
  createdAt                DateTime   @default(now()) @map("created_at")
  updatedAt                DateTime   @updatedAt @map("updated_at")

  @@index([courtId, active])
  @@map("tariff_rules")
}

enum BookingStatus {
  DRAFT
  CHECKOUT_PENDING
  LEGACY_HOLD_PENDING
  PAYMENT_PENDING
  CONFIRMED
  CANCEL_PENDING
  CANCELED
  COMPLETED
  FAILED
  MANUAL_REVIEW
}

enum PaymentStatus {
  NONE
  PENDING
  PARTIALLY_PAID
  PAID
  GUARANTEE_ACTIVE
  FAILED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  AMOUNT_DUE
}

enum PaymentMode {
  FULL
  SPLIT
}

enum SplitServiceFeeAllocation {
  ORGANIZER
  PRO_RATA
}

enum BookingSource {
  WEB
  PWA
  ADMIN
  MIGRATION
  LEGACY_SYNC
  API_FUTURE
}

/// CDC §17, §45 — machine à états réservation. `legacySyncStatus` réutilise
/// l'enum du Lot 2 (mêmes valeurs que CDC §17 "sous-état sync Legacy").
model Booking {
  id                        String                     @id @default(uuid())
  organizerUserId           String                     @map("organizer_user_id")
  organizer                 User                       @relation(fields: [organizerUserId], references: [id])
  courtId                   String                     @map("court_id")
  court                     Court                      @relation(fields: [courtId], references: [id])
  startAt                   DateTime                   @map("start_at")
  endAt                     DateTime                   @map("end_at")
  durationMinutes           Int                        @map("duration_minutes")
  status                    BookingStatus              @default(DRAFT)
  legacySyncStatus          LegacySyncStatus?          @map("legacy_sync_status")
  paymentStatus             PaymentStatus              @default(NONE) @map("payment_status")
  paymentMode               PaymentMode                @default(FULL) @map("payment_mode")
  bookingBasePriceCents     Int                        @map("booking_base_price_cents")
  splitServiceFeeCents      Int?                       @map("split_service_fee_cents")
  splitServiceFeeAllocation SplitServiceFeeAllocation? @map("split_service_fee_allocation")
  priceTotalCents           Int                        @map("price_total_cents")
  currency                  String                     @default("EUR")
  source                    BookingSource              @default(WEB)
  accessStatus              String?                    @map("access_status")
  cancellationDeadline      DateTime?                  @map("cancellation_deadline")
  tariffRuleId              String?                    @map("tariff_rule_id")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  confirmedAt               DateTime?                  @map("confirmed_at")
  canceledAt                DateTime?                  @map("canceled_at")

  participants         BookingParticipant[]
  legacyBookingMapping LegacyBookingMapping?
  payments             Payment[]
  shares               BookingShare[]
  guarantee            BookingGuarantee?
  accessGrants         AccessGrant[]

  @@index([courtId, startAt, endAt])
  @@index([organizerUserId])
  @@map("bookings")
}

enum BookingParticipantRole {
  ORGANIZER
  PLAYER
}

enum BookingParticipantStatus {
  INVITED
  CONFIRMED
  REMOVED
}

/// CDC §18.3, §76 — un participant référence soit un utilisateur V2, soit un
/// client Legacy, soit une simple invitation e-mail, jamais les trois à la fois.
model BookingParticipant {
  id             String                   @id @default(uuid())
  bookingId      String                   @map("booking_id")
  booking        Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId         String?                  @map("user_id")
  legacyClientId String?                  @map("legacy_client_id")
  invitedEmail   String?                  @map("invited_email")
  displayName    String                   @map("display_name")
  role           BookingParticipantRole   @default(PLAYER)
  status         BookingParticipantStatus @default(INVITED)
  createdAt      DateTime                 @default(now()) @map("created_at")

  @@index([bookingId])
  @@index([userId])
  @@map("booking_participants")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

/// CDC §20 — modèle simple ; la réservation ne dépend jamais de l'existence
/// d'une relation d'amitié.
model Friendship {
  id              String           @id @default(uuid())
  requesterUserId String           @map("requester_user_id")
  addresseeUserId String           @map("addressee_user_id")
  status          FriendshipStatus @default(PENDING)
  createdAt       DateTime         @default(now()) @map("created_at")

  @@unique([requesterUserId, addresseeUserId])
  @@index([addresseeUserId])
  @@map("friendships")
}

// =====================================================================
// Lot 4 — Payments online / FULL
// =====================================================================

enum PaymentChannel {
  ONLINE
  QR_HANDOFF
  TERMINAL
}

enum PaymentPurpose {
  BOOKING_FULL
  BOOKING_SHARE
  CREDIT_PACK_PURCHASE
}

/// Statut d'une transaction Payment individuelle — distinct de
/// `Booking.paymentStatus` (état agrégé de la réservation, CDC §17).
/// `AUTHORIZED` = autorisation carte posée, capture pas encore effectuée
/// (CDC §27.1 : autoriser avant Doinsport, capturer après confirmation).
enum PaymentTransactionStatus {
  PENDING
  REQUIRES_ACTION
  AUTHORIZED
  SUCCEEDED
  FAILED
  CANCELED
}

/// CDC §45 (`payments`). `provider_fee_cents`/`provider_net_cents` restent
/// nuls jusqu'à récupération asynchrone du coût réel (CDC §30.3) — jamais
/// calculés depuis un tarif hardcodé.
model Payment {
  id                           String                   @id @default(uuid())
  bookingId                    String?                  @map("booking_id")
  booking                      Booking?                 @relation(fields: [bookingId], references: [id])
  userId                       String                   @map("user_id")
  user                         User                     @relation(fields: [userId], references: [id])
  provider                     String                   @default("stripe")
  providerPaymentId            String                   @unique @map("provider_payment_id")
  paymentChannel               PaymentChannel           @default(ONLINE) @map("payment_channel")
  paymentMethodType            String?                  @map("payment_method_type")
  amountCents                  Int                      @map("amount_cents")
  currency                     String                   @default("EUR")
  status                       PaymentTransactionStatus @default(PENDING)
  purpose                      PaymentPurpose
  providerFeeCents             Int?                     @map("provider_fee_cents")
  providerNetCents             Int?                     @map("provider_net_cents")
  providerFeeCurrency          String?                  @map("provider_fee_currency")
  providerBalanceTransactionId String?                  @map("provider_balance_transaction_id")
  createdAt                    DateTime                 @default(now()) @map("created_at")
  updatedAt                    DateTime                 @updatedAt @map("updated_at")

  refunds            Refund[]
  creditPackPurchase CreditPackPurchase?

  @@index([bookingId])
  @@index([userId])
  @@map("payments")
}

enum RefundFundingSource {
  WALLET
  EXTERNAL
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// CDC §30.1 — traçabilité complète des remboursements.
model Refund {
  id               String              @id @default(uuid())
  paymentId        String              @map("payment_id")
  payment          Payment             @relation(fields: [paymentId], references: [id])
  providerRefundId String?             @map("provider_refund_id")
  amountCents      Int                 @map("amount_cents")
  fundingSource    RefundFundingSource @default(EXTERNAL) @map("funding_source")
  status           RefundStatus        @default(PENDING)
  reason           String?
  createdBy        String?             @map("created_by")
  createdAt        DateTime            @default(now()) @map("created_at")

  @@index([paymentId])
  @@map("refunds")
}

/// CDC §44 — déduplication des webhooks Stripe par `event_id`. Traitement
/// synchrone pour l'instant (pas de file de jobs avant le Lot 7/8) : documenté
/// comme simplification temporaire dans ADR correspondant, pas un oubli.
model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String    @default("stripe")
  eventId     String    @unique @map("event_id")
  eventType   String    @map("event_type")
  processedAt DateTime? @map("processed_at")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("webhook_events")
}

// =====================================================================
// Lot 5 — Wallet / crédits prépayés
// =====================================================================
//
// Principe : `wallet_transactions` est un ledger append-only, jamais un
// solde recalculé par `balance += x` (CDC §111). `balance_total` se calcule
// en sommant les transactions ; `balance_reserved` en sommant les holds
// `ACTIVE` ; `balance_available = total - reserved` (CDC §28.6). Les
// transactions HOLD_CREATED/HOLD_RELEASED/HOLD_CAPTURED sont une trace
// d'audit — elles ne participent jamais au calcul de `balance_total` (sinon
// double comptage avec le hold lui-même) : seul `wallet_holds.status=ACTIVE`
// compte pour `balance_reserved`, et seule une vraie transaction de débit
// (`DEBIT_BOOKING`, créée au moment de la capture d'un hold) réduit
// `balance_total`.

enum WalletAccountStatus {
  ACTIVE
  CLOSED
}

/// CDC §28.4 — un wallet par utilisateur, fermé à l'écosystème Ardenne Padel
/// (pas de transfert, pas de retrait, pas de P2P — CDC §28.1).
model WalletAccount {
  id        String              @id @default(uuid())
  userId    String              @unique @map("user_id")
  user      User                @relation(fields: [userId], references: [id])
  currency  String              @default("EUR")
  status    WalletAccountStatus @default(ACTIVE)
  createdAt DateTime            @default(now()) @map("created_at")

  transactions WalletTransaction[]
  holds        WalletHold[]

  @@map("wallet_accounts")
}

enum WalletTransactionType {
  CREDIT_PACK_PURCHASE
  CREDIT_PACK_BONUS
  CREDIT_ADMIN
  DEBIT_BOOKING
  REFUND_BOOKING
  HOLD_CREATED
  HOLD_RELEASED
  HOLD_CAPTURED
  ADJUSTMENT
  BONUS_EXPIRY
  /// Lot Nextore E — paiement bar par crédits (PAY-003). Symétrique à
  /// DEBIT_BOOKING/REFUND_BOOKING mais référence `nextoreAccountId` au lieu
  /// de `bookingId` (jamais les deux sur la même ligne).
  DEBIT_NEXTORE_ACCOUNT
  REFUND_NEXTORE_ACCOUNT
}

enum WalletCreditOrigin {
  PAID
  BONUS
  ADMIN_COMP
}

/// CDC §28.4-§28.5 — ledger append-only. `amountCents` signé (positif =
/// crédit, négatif = débit). `creditOrigin` distingue payé/bonus/offert par
/// admin — nécessaire pour restituer fidèlement la composition d'origine
/// lors d'un remboursement (CDC §28.10) plutôt qu'un simple montant global.
model WalletTransaction {
  id                   String                @id @default(uuid())
  walletAccountId      String                @map("wallet_account_id")
  walletAccount        WalletAccount         @relation(fields: [walletAccountId], references: [id])
  type                 WalletTransactionType
  amountCents          Int                   @map("amount_cents")
  creditOrigin         WalletCreditOrigin?   @map("credit_origin")
  bookingId            String?               @map("booking_id")
  creditPackPurchaseId String?               @map("credit_pack_purchase_id")
  walletHoldId         String?               @map("wallet_hold_id")
  /// Lot Nextore E — référence libre vers `NextoreAccount.id`, même statut
  /// que `bookingId` (pas de FK stricte, deux domaines distincts).
  nextoreAccountId     String?               @map("nextore_account_id")
  reference            String?
  createdBy            String?               @map("created_by")
  metadata             Json?
  createdAt            DateTime              @default(now()) @map("created_at")

  @@index([walletAccountId])
  @@index([bookingId])
  @@index([creditPackPurchaseId])
  @@index([nextoreAccountId])
  @@map("wallet_transactions")
}

enum WalletHoldStatus {
  ACTIVE
  RELEASED
  CAPTURED
  EXPIRED
}

/// CDC §28.6 — crédits temporairement réservés comme garantie. Un hold
/// capturé ou libéré ne peut jamais l'être deux fois (CDC §47.2.bis) — les
/// services applicatifs doivent vérifier `status=ACTIVE` avant toute
/// transition, jamais recalculer depuis l'historique seul.
model WalletHold {
  id              String           @id @default(uuid())
  walletAccountId String           @map("wallet_account_id")
  walletAccount   WalletAccount    @relation(fields: [walletAccountId], references: [id])
  bookingId       String?          @map("booking_id")
  amountCents     Int              @map("amount_cents")
  status          WalletHoldStatus @default(ACTIVE)
  expiresAt       DateTime?        @map("expires_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  capturedAt      DateTime?        @map("captured_at")
  releasedAt      DateTime?        @map("released_at")

  @@index([walletAccountId, status])
  @@index([bookingId])
  @@map("wallet_holds")
}

/// CDC §28.2 — packs configurables, aucun taux de bonus hardcodé.
model CreditPack {
  id                  String    @id @default(uuid())
  name                String
  purchaseAmountCents Int       @map("purchase_amount_cents")
  paidCreditsCents    Int       @map("paid_credits_cents")
  bonusCreditsCents   Int       @default(0) @map("bonus_credits_cents")
  active              Boolean   @default(true)
  salesChannels       String[]  @map("sales_channels")
  validFrom           DateTime? @map("valid_from")
  validUntil          DateTime? @map("valid_until")
  displayOrder        Int       @map("display_order")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  purchases CreditPackPurchase[]

  @@map("credit_packs")
}

enum CreditPackPurchaseStatus {
  PENDING
  PAID
  CREDITED
  FAILED
}

/// CDC §28.2-§28.4 — un achat ne crédite le wallet qu'une seule fois
/// (garde-fou d'idempotence dans `CreditPackService`, pas seulement ici).
model CreditPackPurchase {
  id                  String                   @id @default(uuid())
  creditPackId        String                   @map("credit_pack_id")
  creditPack          CreditPack               @relation(fields: [creditPackId], references: [id])
  userId              String                   @map("user_id")
  user                User                     @relation(fields: [userId], references: [id])
  paymentId           String?                  @unique @map("payment_id")
  payment             Payment?                 @relation(fields: [paymentId], references: [id])
  purchaseAmountCents Int                      @map("purchase_amount_cents")
  paidCreditsCents    Int                      @map("paid_credits_cents")
  bonusCreditsCents   Int                      @map("bonus_credits_cents")
  status              CreditPackPurchaseStatus @default(PENDING)
  createdAt           DateTime                 @default(now()) @map("created_at")

  @@index([userId])
  @@map("credit_pack_purchases")
}

// =====================================================================
// Lot 6 — Paiement partagé (SPLIT)
// =====================================================================

enum BookingGuaranteeType {
  CARD_OFF_SESSION
  WALLET_RESERVE
}

enum BookingGuaranteeStatus {
  ACTIVE
  PARTIALLY_RELEASED
  CONSUMED
  RELEASED
  FAILED
}

/// CDC §25.4 — un seul mécanisme de garantie actif par réservation SPLIT
/// (§25.3 : jamais de combinaison carte + wallet dans le MVP).
model BookingGuarantee {
  id                       String                 @id @default(uuid())
  bookingId                String                 @unique @map("booking_id")
  booking                  Booking                @relation(fields: [bookingId], references: [id])
  type                     BookingGuaranteeType
  organizerUserId          String                 @map("organizer_user_id")
  guaranteedAmountCents    Int                    @map("guaranteed_amount_cents")
  remainingGuaranteedCents Int                    @map("remaining_guaranteed_cents")
  walletHoldId             String?                @map("wallet_hold_id")
  paymentMethodId          String?                @map("payment_method_id")
  status                   BookingGuaranteeStatus @default(ACTIVE)
  createdAt                DateTime               @default(now()) @map("created_at")
  releasedAt               DateTime?              @map("released_at")

  @@map("booking_guarantees")
}

enum BookingShareStatus {
  OPEN
  INVITED
  PAYMENT_PENDING
  PAID
  COVERED_BY_ORGANIZER
  CANCELED
  REFUNDED
}

enum BookingShareFundingSource {
  WALLET
  EXTERNAL
}

/// CDC §26.1 — une part par participant. Le lien d'invitation devient
/// inutilisable après paiement/annulation/expiration (CDC §26.2) : vérifié
/// par `status` + `invitationExpiresAt`, jamais par simple suppression de ligne.
model BookingShare {
  id                    String                     @id @default(uuid())
  bookingId             String                     @map("booking_id")
  booking               Booking                    @relation(fields: [bookingId], references: [id])
  participantUserId     String?                    @map("participant_user_id")
  legacyClientId        String?                    @map("legacy_client_id")
  invitedEmail          String?                    @map("invited_email")
  baseAmountCents       Int                        @map("base_amount_cents")
  serviceFeeAmountCents Int                        @default(0) @map("service_fee_amount_cents")
  totalAmountCents      Int                        @map("total_amount_cents")
  status                BookingShareStatus         @default(OPEN)
  fundingSource         BookingShareFundingSource? @map("funding_source")
  paidByUserId          String?                    @map("paid_by_user_id")
  paymentId             String?                    @map("payment_id")
  walletTransactionId   String?                    @map("wallet_transaction_id")
  invitationTokenHash   String?                    @unique @map("invitation_token_hash")
  invitationExpiresAt   DateTime?                  @map("invitation_expires_at")
  dueAt                 DateTime?                  @map("due_at")
  createdAt             DateTime                   @default(now()) @map("created_at")
  paidAt                DateTime?                  @map("paid_at")

  @@index([bookingId])
  @@index([participantUserId])
  @@map("booking_shares")
}

// =====================================================================
// Lot 7 — Kiosque / Terminal
// =====================================================================

enum KioskDeviceStatus {
  ACTIVE
  REVOKED
}

/// CDC §22.6, §59.2 — dispositif enregistré et révocable. Le secret n'est
/// jamais stocké en clair (seul son hash), même logique que les tokens
/// d'invitation/vérification (CDC §57.1).
model KioskDevice {
  id            String            @id @default(uuid())
  name          String
  location      String?
  status        KioskDeviceStatus @default(ACTIVE)
  deviceKeyHash String            @unique @map("device_key_hash")
  capabilities  String[]
  lastSeenAt    DateTime?         @map("last_seen_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  revokedAt     DateTime?         @map("revoked_at")

  checkoutSessions KioskCheckoutSession[]

  @@map("kiosk_devices")
}

enum KioskSessionStatus {
  PENDING
  CLAIMED
  COMPLETED
  EXPIRED
  CANCELED
}

/// CDC §22.2 — session de reprise QR. Le "booking draft" du CDC est ici
/// représenté par les champs de créneau (`courtId`/`startAt`/`durationMinutes`)
/// tant que personne n'est authentifié ; `bookingId` n'est renseigné qu'après
/// la réclamation (CDC §22.2 étape 5 : "le smartphone reprend exactement le
/// checkout en cours"), pour ne jamais exiger un organisateur avant qu'un
/// utilisateur réel ne soit identifié.
model KioskCheckoutSession {
  id              String             @id @default(uuid())
  kioskDeviceId   String             @map("kiosk_device_id")
  kioskDevice     KioskDevice        @relation(fields: [kioskDeviceId], references: [id])
  courtId         String             @map("court_id")
  startAt         DateTime           @map("start_at")
  durationMinutes Int                @map("duration_minutes")
  paymentMode     PaymentMode        @default(FULL) @map("payment_mode")
  tokenHash       String             @unique @map("token_hash")
  status          KioskSessionStatus @default(PENDING)
  bookingId       String?            @unique @map("booking_id")
  claimedByUserId String?            @map("claimed_by_user_id")
  expiresAt       DateTime           @map("expires_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  completedAt     DateTime?          @map("completed_at")

  @@index([kioskDeviceId, status])
  @@map("kiosk_checkout_sessions")
}

enum TerminalDeviceStatus {
  ACTIVE
  OFFLINE
  REVOKED
}

/// CDC §22.3-§22.4 — lecteur Stripe Terminal enregistré. Ne jamais coupler
/// le domaine à un modèle de lecteur précis (CDC §22.4).
model TerminalDevice {
  id               String               @id @default(uuid())
  provider         String               @default("stripe")
  providerDeviceId String               @unique @map("provider_device_id")
  name             String
  location         String?
  status           TerminalDeviceStatus @default(ACTIVE)
  capabilities     String[]
  lastSeenAt       DateTime?            @map("last_seen_at")
  createdAt        DateTime             @default(now()) @map("created_at")

  @@map("terminal_devices")
}

/// Journal d'audit append-only minimal (CDC §58) — enrichi lot par lot avec
/// de nouvelles actions au fur et à mesure que les modules apparaissent.
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  reason      String?
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// =====================================================================
// Lot 8 — Access / Notifications
// =====================================================================

enum AccessGrantOrigin {
  V2_GENERATED
  LEGACY_IMPORTED
}

enum AccessGrantStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
  FAILED
}

/// CDC §34 — code d'accès `NNNN#` par réservation. `codeCiphertext`/`codeIv`
/// protègent le code en base (jamais stocké en clair, CDC §34.4) : seul le
/// service applicatif peut le déchiffrer pour l'afficher à l'organisateur ou
/// le transmettre à un `AccessProvider` matériel. `origin` porte la
/// coexistence Dual Run (CDC §35) : un grant `LEGACY_IMPORTED` provient d'un
/// code déjà généré par Doinsport, jamais dupliqué par un grant V2 (§78).
model AccessGrant {
  id                String            @id @default(uuid())
  bookingId         String            @map("booking_id")
  booking           Booking           @relation(fields: [bookingId], references: [id])
  codeCiphertext    String            @map("code_ciphertext")
  codeIv            String            @map("code_iv")
  origin            AccessGrantOrigin
  scope             String
  status            AccessGrantStatus @default(PENDING)
  validFrom         DateTime          @map("valid_from")
  validUntil        DateTime          @map("valid_until")
  provisionedAt     DateTime?         @map("provisioned_at")
  revokedAt         DateTime?         @map("revoked_at")
  providerReference String?           @map("provider_reference")
  createdAt         DateTime          @default(now()) @map("created_at")

  @@index([bookingId])
  @@index([scope, validFrom, validUntil])
  @@map("access_grants")
}

// =====================================================================
// Automatisation physique (Raspberry) — Phase 1 : données uniquement.
// CDC automatisation §"snapshot"/"device sync" — aucune action physique
// n'est déclenchée par le serveur (dossier technique §36 : le mapping
// matériel Modbus/LOGO! reste local au Raspberry). Le serveur expose
// uniquement : zones logiques, snapshot versionné des grants/zones,
// remontée d'événements idempotente, heartbeat, et une file de commandes
// MVP explicitement listées (jamais de commande bas niveau).
// =====================================================================

enum ZoneType {
  DOOR
  LIGHT
  GENERIC
}

/// Regroupe un ou plusieurs `AccessGrant.scope` (aujourd'hui le courtId) sous
/// une zone physique pilotable par le Raspberry. `courtId` reste optionnel
/// car une zone comme "entrée principale" ne correspond à aucun terrain.
/// `doorBeforeMinutes`/`doorAfterMinutes` (zone `DOOR` avec `courtId`) et
/// `lightBeforeMinutes`/`lightAfterMinutes` (zone `LIGHT`) surchargent, pour
/// ce terrain, les marges globales `ACCESS_ENABLED_BEFORE/AFTER_MINUTES` et
/// `LIGHT_ENABLED_BEFORE/AFTER_MINUTES` — `null` = utiliser la valeur
/// globale. Éditables depuis `/admin/automation` plutôt que par variable
/// d'environnement, pour permettre un réglage différent par terrain sans
/// redéploiement (demande explicite : chaque terrain peut avoir des
/// horaires d'accès/éclairage différents).
model Zone {
  id                 String   @id @default(uuid())
  key                String   @unique
  type               ZoneType
  label              String
  courtId            String?  @map("court_id")
  court              Court?   @relation(fields: [courtId], references: [id])
  active             Boolean  @default(true)
  doorBeforeMinutes  Int?     @map("door_before_minutes")
  doorAfterMinutes   Int?     @map("door_after_minutes")
  lightBeforeMinutes Int?     @map("light_before_minutes")
  lightAfterMinutes  Int?     @map("light_after_minutes")
  createdAt          DateTime @default(now()) @map("created_at")

  commands   AccessCommand[]
  staffCodes StaffAccessCodeZone[]

  @@map("automation_zones")
}

enum StaffAccessCodeStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

/// Code maître employé (nominatif, CDC : "avoir aussi les codes maîtres pour
/// les employés") — jamais lié à une réservation, contrairement à
/// `AccessGrant`. Porté par `zones` (many-to-many via `StaffAccessCodeZone`) :
/// zone par zone plutôt qu'universel, décision explicite (chaque employé
/// peut n'avoir accès qu'à certaines portes/zones). `expiresAt` optionnel —
/// `null` = valable jusqu'à révocation manuelle (ex. gérant permanent),
/// renseigné pour un accès temporaire (remplaçant, prestataire, stagiaire).
model StaffAccessCode {
  id             String                @id @default(uuid())
  employeeName   String                @map("employee_name")
  codeCiphertext String                @map("code_ciphertext")
  codeIv         String                @map("code_iv")
  status         StaffAccessCodeStatus @default(ACTIVE)
  expiresAt      DateTime?             @map("expires_at")
  createdBy      String?               @map("created_by")
  createdAt      DateTime              @default(now()) @map("created_at")
  revokedAt      DateTime?             @map("revoked_at")

  zones StaffAccessCodeZone[]

  @@map("staff_access_codes")
}

model StaffAccessCodeZone {
  id     String          @id @default(uuid())
  codeId String          @map("code_id")
  code   StaffAccessCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  zoneId String          @map("zone_id")
  zone   Zone            @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([codeId, zoneId])
  @@map("staff_access_code_zones")
}

enum AccessDeviceType {
  RASPBERRY_ACCESS_CONTROLLER
}

enum AccessDeviceStatus {
  ACTIVE
  REVOKED
}

/// Device Raspberry authentifié par clé opaque (même schéma que
/// `KioskDevice` — CDC §57.1 : la clé brute n'est jamais stockée). Jamais de
/// session utilisateur pour ces endpoints. `lastSyncRevision` permet le
/// 304/ETag sur le snapshot.
model AccessDevice {
  id               String             @id @default(uuid())
  name             String
  type             AccessDeviceType   @default(RASPBERRY_ACCESS_CONTROLLER)
  deviceKeyHash    String             @unique @map("device_key_hash")
  status           AccessDeviceStatus @default(ACTIVE)
  lastSeenAt       DateTime?          @map("last_seen_at")
  lastSyncRevision String?            @map("last_sync_revision")
  lastHeartbeat    Json?              @map("last_heartbeat")
  createdAt        DateTime           @default(now()) @map("created_at")
  revokedAt        DateTime?          @map("revoked_at")

  events   AccessDeviceEvent[]
  commands AccessCommand[]

  @@map("access_devices")
}

/// Remontée d'événements idempotente : la paire (deviceId, eventId) est
/// unique, un doublon réseau (retry après perte de connexion) ne crée jamais
/// deux lignes.
model AccessDeviceEvent {
  id         String       @id @default(uuid())
  deviceId   String       @map("device_id")
  device     AccessDevice @relation(fields: [deviceId], references: [id])
  eventId    String       @map("event_id")
  type       String
  payload    Json?
  occurredAt DateTime     @map("occurred_at")
  receivedAt DateTime     @default(now()) @map("received_at")

  @@unique([deviceId, eventId])
  @@index([deviceId, occurredAt])
  @@map("access_device_events")
}

/// CDC_APV2_COMMANDES_MANUELLES_RASPBERRY_LOGO §6/§9/§10 — vocabulaire métier
/// exposé au Raspberry ; AP V2 ne connaît jamais les adresses Modbus (M2/M3)
/// ni le mapping LOGO! réel, qui reste entièrement local au Raspberry.
enum AccessCommandType {
  DOOR_OPEN
  DOOR_CLOSE
  LIGHT_ON
  LIGHT_OFF
}

enum AccessCommandStatus {
  PENDING
  DELIVERED
  SUCCESS
  FAILED
  EXPIRED
}

/// Commandes MVP explicitement listées — jamais de commande bas niveau (le
/// serveur ignore le mapping Modbus/LOGO!, dossier technique §36/§37).
/// Modèle "pull" : livrées au Raspberry via le snapshot, jamais de push
/// serveur (le Raspberry n'accepte aucune connexion entrante).
///
/// Cycle PENDING -> DELIVERED -> SUCCESS|FAILED (ACK) -> EXPIRED (fallback).
/// Une commande DELIVERED mais non acquittée reste éligible et redélivrée à
/// chaque snapshot tant qu'elle n'est pas ACKée ni expirée (RASPBERRY_PROTOCOL.md
/// §"Fiabilité des commandes") — DELIVERED n'est jamais un état terminal :
/// perdre le device après réception (crash avant ouverture, reboot) ne doit
/// jamais faire disparaître la commande, seul un ACK explicite le fait.
/// SUCCESS/FAILED ne veulent dire que "le Raspberry a traité la commande" —
/// jamais une preuve d'état physique réel (pas de capteur de porte à ce
/// stade, CDC_APV2_COMMANDES_MANUELLES_RASPBERRY_LOGO §15).
///
/// `zoneId` est optionnel : une commande automatisée (future, planning
/// lumière) cible une zone ; une commande manuelle déclenchée depuis le
/// back-office (§11 du CDC ci-dessus) cible directement un `deviceId`, sans
/// zone — un seul Raspberry pilotant porte + éclairage du club.
model AccessCommand {
  id          String              @id @default(uuid())
  zoneId      String?             @map("zone_id")
  zone        Zone?               @relation(fields: [zoneId], references: [id])
  deviceId    String?             @map("device_id")
  device      AccessDevice?       @relation(fields: [deviceId], references: [id])
  type        AccessCommandType
  status      AccessCommandStatus @default(PENDING)
  requestedBy String?             @map("requested_by")
  /// Résultat rapporté par le Raspberry à l'ACK : "SUCCESS", ou un code
  /// d'erreur local (ex. "LOGO_CONNECTION_FAILED") si `status = FAILED`.
  result      String?
  createdAt   DateTime            @default(now()) @map("created_at")
  deliveredAt DateTime?           @map("delivered_at")
  ackedAt     DateTime?           @map("acked_at")
  expiresAt   DateTime            @map("expires_at")

  @@index([zoneId, status])
  @@index([deviceId, status])
  @@map("access_commands")
}

enum NotificationTemplate {
  EMAIL_VERIFICATION
  MIGRATION_INVITATION
  BOOKING_CONFIRMATION
  PARTICIPANT_INVITATION
  PARTICIPANT_PAYMENT_CONFIRMED
  CREDIT_PACK_PURCHASE_CONFIRMED
  WALLET_CREDITED
  INSUFFICIENT_BALANCE_OR_GUARANTEE
  BOOKING_REMINDER
  BOOKING_CANCELED
  REFUND_ISSUED
  ORGANIZER_REGULARIZATION
  REGULARIZATION_FAILED
  SIGNIFICANT_ADMIN_CHANGE
  ACADEMY_LESSON_PROPOSED
  ACADEMY_LESSON_CONFIRMED
  ACADEMY_LESSON_CANCELLED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// CDC §37.3 — outbox durable : une notification est toujours persistée
/// avant d'être envoyée, pour qu'un échec d'envoi (SMTP temporairement
/// indisponible) ne puisse jamais annuler ou masquer la transaction métier
/// qui l'a déclenchée. `recipientUserId` est résolu en e-mail au moment de
/// l'envoi (pas à l'écriture) pour rester correct même si l'adresse change
/// entre-temps ; `recipientEmail` sert aux destinataires sans compte
/// (invités SPLIT par exemple).
model NotificationOutbox {
  id              String               @id @default(uuid())
  template        NotificationTemplate
  recipientUserId String?              @map("recipient_user_id")
  recipientEmail  String?              @map("recipient_email")
  payload         Json
  status          NotificationStatus   @default(PENDING)
  attempts        Int                  @default(0)
  lastError       String?              @map("last_error")
  scheduledFor    DateTime             @default(now()) @map("scheduled_for")
  sentAt          DateTime?            @map("sent_at")
  createdAt       DateTime             @default(now()) @map("created_at")

  @@index([status, scheduledFor])
  @@map("notification_outbox")
}

