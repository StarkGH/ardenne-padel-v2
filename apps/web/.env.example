# Ardenne Padel V2 — variables d'environnement du frontend
# Ne jamais committer de vraies valeurs.

# Base URL du backend, appelée depuis le navigateur (credentials: "include").
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Base URL publique du frontend — utilisée pour construire l'URL encodée dans
# le QR code de reprise kiosque (CDC §54.1 écran 5).
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3001

# Clé du dispositif kiosque (CDC §22.2, §57.1) — jamais la même qu'en
# production ; une vraie clé est générée une seule fois via
# POST /admin/kiosk-devices et injectée hors dépôt (ex. variable d'env du
# déploiement de la tablette), jamais commitée.
NEXT_PUBLIC_KIOSK_DEVICE_KEY=dev-kiosk-accueil-do-not-use-in-prod
