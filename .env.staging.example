# Environnement de staging — variables consommées par docker-compose.staging.yml.
# Copier en `.env.staging` sur le serveur cible, ne jamais committer de
# vraies valeurs (CDC 59.3). Complète .env.example — toutes les variables
# applicatives listées là-bas restent valables ici (API_PORT, WEB_PORT,
# feature flags Legacy/Stripe/wallet/etc.), seules les valeurs changent.

# --- Domaine et URLs publiques ---
STAGING_DOMAIN=staging.ardennepadel.example
PUBLIC_BASE_URL=https://staging.ardennepadel.example
API_BASE_URL=https://staging.ardennepadel.example/api/v1
NODE_ENV=staging

# --- Base de données (nom de service Docker Compose, pas localhost) ---
POSTGRES_USER=ardenne
POSTGRES_PASSWORD=change-me-generate-a-real-secret
POSTGRES_DB=ardenne_padel_v2
DATABASE_URL=postgres://ardenne:change-me-generate-a-real-secret@db:5432/ardenne_padel_v2

# --- Secrets à générer réellement avant tout déploiement (jamais réutiliser
# une valeur de dev, voir docs/operations.md) ---
SESSION_SECRET=change-me-generate-a-real-secret

# --- Variables NEXT_PUBLIC_* — inlinées dans le bundle client au build
# (docker-compose.staging.yml, service web, `args:`) — jamais un secret,
# uniquement des valeurs publiques ---
NEXT_PUBLIC_API_BASE_URL=https://staging.ardennepadel.example/api/v1
NEXT_PUBLIC_WEB_BASE_URL=https://staging.ardennepadel.example
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_KIOSK_DEVICE_KEY=

# --- Le reste : voir .env.example (Doinsport, Stripe secret, notifications,
# accès/kiosque, rate limiting...) — à copier ligne par ligne dans ce même
# fichier .env.staging avec des valeurs réelles de test avant premier déploiement.
